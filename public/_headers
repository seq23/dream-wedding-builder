# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/product-previews/*
  Cache-Control: public,max-age=604800
  X-Content-Type-Options: nosniff

# Pictures, the logo, pin images and the free sample change only with a deploy and are
# not fingerprinted, so a browser may keep them for a day and the edge for a week.
/product-images/*
  Cache-Control: public,max-age=86400,s-maxage=604800
/brand/*
  Cache-Control: public,max-age=86400,s-maxage=604800
/pinterest/*
  Cache-Control: public,max-age=86400,s-maxage=604800
/samples/*
  Cache-Control: public,max-age=86400,s-maxage=604800
