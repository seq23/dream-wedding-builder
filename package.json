{
  "name": "dream-wedding-builder",
  "version": "0.1.0",
  "private": true,
  "description": "No-auth wedding planning dashboard that turns a dream wedding into pricing, levers, trends, vendor options, and a printable Dream Wedding Starter Pack.",
  "scripts": {
    "admin:hash-password": "node scripts/admin/hash-password.mjs",
    "atlas:build": "node scripts/atlas/build_query_atlas.mjs",
    "authority:all": "npm run authority:yield:build && npm run authority:atlas && npm run authority:flow && npm run authority:sitemaps && npm run authority:scale:validate && npm run distribution:prepare && npm run distribution:validate",
    "authority:atlas": "node scripts/authority/build-atlas.mjs",
    "authority:flow": "node scripts/authority/run-full-flow.mjs",
    "authority:routes:check": "node scripts/authority_scale/check_guide_routes.mjs",
    "authority:scale:clear-scope": "node scripts/authority_scale/clear_mutation_scope.mjs",
    "authority:scale:fanout": "node scripts/authority_scale/build_max_fanout.mjs",
    "authority:scale:freeze": "node scripts/authority_scale/freeze_authority_content.mjs",
    "authority:scale:publish": "node scripts/authority_scale/publish_authority_batch.mjs",
    "authority:scale:restore": "node scripts/authority_scale/restore_authority_content.mjs",
    "authority:scale:validate": "node scripts/authority_scale/validate_authority_scale.mjs && npm run validate:kpi-truth && npm run authority:yield:validate",
    "authority:sitemaps": "npm run seo:lastmod && node scripts/authority/build-sitemaps.mjs",
    "authority:spec:derive": "node scripts/authority_scale/derive_composition_spec.mjs",
    "authority:velocity:evaluate": "node scripts/authority_scale/evaluate_velocity.mjs",
    "authority:yield:build": "node scripts/authority_scale/build_citation_yield_feedback.mjs && node scripts/authority_scale/evaluate_velocity.mjs",
    "authority:yield:validate": "node scripts/authority_scale/validate_citation_yield_feedback.mjs",
    "baseline": "node scripts/baseline.mjs",
    "build": "node scripts/install_clarity.mjs && NODE_OPTIONS=--max-old-space-size=3072 next build --no-lint",
    "cadence:derive": "node scripts/cadence/derive_capacity.mjs",
    "cadence:gate": "node scripts/cadence_gate.js",
    "cadence:gate:merge": "node scripts/cadence_gate.js --merge-gate",
    "cadence:headroom": "node scripts/cadence/publish_headroom.mjs",
    "cadence:refresh": "node scripts/cadence/refresh_lane.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cloudflare:discover": "node scripts/providers/cloudflare-discover.mjs",
    "d1:migrate:remote": "wrangler d1 execute dream-wedding-builder --remote --file=migrations/0001_fulfillment.sql",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy && node scripts/check-live-cron.mjs",
    "dev": "next dev",
    "distribution:gsc": "node scripts/distribution/submit_gsc_sitemaps.mjs",
    "distribution:indexnow": "node scripts/distribution/submit_indexnow.mjs",
    "distribution:prepare": "node scripts/distribution/prepare_distribution.mjs",
    "distribution:validate": "node scripts/distribution/validate_distribution.mjs",
    "entity:watch": "node scripts/entity/entity_backlink_watch.mjs",
    "lint": "next lint || echo 'next lint unavailable in this Next version; validators still run'",
    "load:ai-draft": "node scripts/load/ai-draft-day.mjs",
    "llm:check": "node scripts/llm/free_router.mjs --check --ping",
    "pinterest:images": "python3 scripts/pinterest/generate_pin_images.py",
    "pinterest:metrics": "node scripts/pinterest/collect_metrics.mjs",
    "pinterest:queue": "node scripts/pinterest/pin_queue.mjs",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "proof:fulfillment": "node scripts/verify-fulfillment-e2e.mjs",
    "proof:local-full": "npm run typecheck && npm run test && npm run authority:all && npm run validate:structural && npm run build",
    "release:package": "node scripts/providers/package-product-releases.mjs",
    "release:upload": "node scripts/providers/upload-product-releases.mjs",
    "search:citations": "node scripts/search_intelligence/llm_citation_probe.mjs",
    "search:consolidation": "node scripts/search_intelligence/build_consolidation_candidates.mjs",
    "search:coverage": "node scripts/search_intelligence/collect_index_coverage.mjs",
    "search:cycle": "npm run search:targets && npm run search:gsc && npm run search:target-set && npm run search:consolidation && npm run search:diagnose && npm run search:repair && npm run search:retest && npm run search:status",
    "search:diagnose": "node scripts/search_intelligence/diagnose.mjs",
    "search:gsc": "node scripts/search_intelligence/collect_gsc.mjs",
    "search:observe:import": "node scripts/search_intelligence/import_agent_observations.mjs",
    "search:repair": "node scripts/search_intelligence/apply_repairs.mjs",
    "search:retest": "node scripts/search_intelligence/retest.mjs",
    "search:status": "node scripts/search_intelligence/status.mjs",
    "search:target-set": "node scripts/search_intelligence/build_target_query_set.mjs",
    "search:targets": "node scripts/search_intelligence/build_targets.mjs",
    "search:week-diff": "node scripts/search_intelligence/week_diff.mjs",
    "secrets:generate": "node scripts/providers/generate-runtime-secrets.mjs",
    "selfheal": "node scripts/selfheal/heal_until_clean.mjs",
    "selfheal:dry": "node scripts/selfheal/heal_until_clean.mjs --dry-run",
    "seo:lastmod": "node scripts/seo/build_lastmod_ledger.mjs",
    "start": "next start",
    "stripe:bootstrap:live": "STRIPE_MODE=live node scripts/providers/stripe-bootstrap.mjs",
    "stripe:bootstrap:test": "STRIPE_MODE=test node scripts/providers/stripe-bootstrap.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "PLAYWRIGHT_VIDEO=1 playwright test",
    "test:e2e:gauntlet": "playwright test tests/e2e/gauntlet",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "upload": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare upload",
    "validate:all": "npm run typecheck && npm run test && npm run validate:structural",
    "validate:amazon-paths": "node scripts/validate-amazon-landing-paths.mjs",
    "validate:authority-registry": "node scripts/validate-authority-registry.mjs",
    "validate:book-domain": "node scripts/validate-book-domain.mjs",
    "validate:cadence-policy": "node scripts/cadence/derive_capacity.mjs --check",
    "validate:refresh-lane-wiring": "node scripts/validators/validate_refresh_lane_wiring.mjs",
    "validate:commerce": "node scripts/validate-commerce.mjs",
    "validate:contracts": "npm run validate:commerce && npm run validate:downloads && npm run validate:secrets && npm run validate:fulfillment-path && npm run validate:amazon-paths",
    "validate:conversion-admin": "node scripts/validate-conversion-admin.mjs",
    "validate:disclaimers": "node scripts/validate-disclaimers.mjs",
    "validate:downloads": "node scripts/validate-downloads.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:fulfillment-path": "node scripts/validate-fulfillment-path.mjs",
    "validate:kpi-truth": "node scripts/authority_scale/validate_kpi_truth.mjs",
    "validate:live-check": "node scripts/validate/live-check.mjs",
    "validate:no-theater": "node scripts/validate-no-theater.mjs",
    "validate:pinfeed": "vitest run tests/unit/pinfeed.test.ts",
    "validate:pinqueue": "vitest run tests/unit/pinqueue.test.ts",
    "validate:product-reachability": "node scripts/validators/validate_product_reachability.mjs",
    "validate:registry": "node scripts/validate/run-registry.mjs",
    "validate:rendered-seo": "node scripts/validators/validate_rendered_seo_contract.mjs",
    "validate:secrets": "node scripts/validate-secrets.mjs",
    "validate:selfheal-contract": "node scripts/validators/validate_selfheal_status_contract.mjs",
    "validate:structural": "npm run validate:env && npm run validate:disclaimers && npm run validate:no-theater && npm run validate:authority-registry && npm run validate:contracts && npm run validate:conversion-admin && npm run validate:zero-paid-llm && npm run validate:cadence-policy && npm run validate:refresh-lane-wiring && npm run validate:product-reachability && npm run validate:worker-entrypoint && npm run validate:selfheal-contract && npm run validate:workflow-shell-quoting && npm run validate:workflow-push-back && npm run validate:search-loop-ai-measured && npm run validate:question-links && npm run validate:brand-social",
    "validate:worker-entrypoint": "node scripts/validate-worker-entrypoint.mjs",
    "validate:workflow-push-back": "node scripts/validators/validate_workflow_push_back.mjs",
    "validate:workflow-shell-quoting": "node scripts/validators/validate_workflow_inline_shell_quoting.mjs",
    "validate:zero-paid-llm": "node scripts/llm/validate_zero_paid_llm.mjs",
    "vault:check": "node scripts/vault/vault.mjs check",
    "vault:exec": "node scripts/vault/vault.mjs exec",
    "vault:init": "node scripts/vault/vault.mjs init",
    "validate:search-loop-ai-measured": "node scripts/validators/validate_search_loop_ai_measured.mjs",
    "seo:normalize-question-entity": "node scripts/seo/normalize_question_entity.mjs",
    "validate:question-links": "node scripts/validators/validate_question_links.mjs",
    "seo:normalize-question-routes": "node scripts/seo/normalize_question_routes.mjs",
    "validate:brand-social": "node scripts/validators/validate_brand_social.mjs",
    "brand-social:collect": "node scripts/brand_social/collect_metrics.mjs",
    "brand-social:prove": "node scripts/brand_social/collect_metrics.mjs --prove",
    "load:app-day": "node scripts/load/app-day.mjs"
  },
  "dependencies": {
    "next": "15.5.18",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "sql.js": "^1.13.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.0.14",
    "wrangler": "^4.110.0"
  }
}
