{
  "name": "dream-wedding-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --offline",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.unit.ts",
    "check": "npm run typecheck && npm test",
    "icons": "node scripts/make-icons.mjs",
    "bundle": "expo export --platform ios --platform android",
    "preview:web": "expo export --platform web",
    "release-gate": "node scripts/release-gate.mjs",
    "eas-build-pre-install": "node scripts/release-gate.mjs --if-production"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.2.1",
    "expo": "58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-notifications": "~58.1.7",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "^11.0.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
