{
  "version": "1.0.0",
  "canonical_scheme": "https",
  "parent_host": "weddingchecklistpdf.com",
  "satellite_rule": "Owner ruling 2026-11-03 (spry brain): weddingchecklistpdf.com is the canonical main wedding site. Shared or general wedding guides live there only; a satellite host keeps only pages about its own tool (its hub, its product page and the guides about the tool itself), listed in hosts.<host>.own_tool_paths. Every other path requested on a satellite 301s to the main site. tests/unit/satellite-own-tool-only.test.ts fails on any satellite-owned route outside that list.",
  "hosts": {
    "weddingchecklistpdf.com": {
      "root_action": "render",
      "root_target": "/",
      "product_id": "checklist-pdf"
    },
    "weddingbudgetspreadsheet.com": {
      "root_action": "redirect",
      "root_target": "/wedding-budget-spreadsheet",
      "product_id": "budget-spreadsheet",
      "own_tool_paths": [
        "/wedding-budget-spreadsheet",
        "/products/budget-spreadsheet",
        "/guides/wedding-budget-template",
        "/guides/wedding-budget-calculator",
        "/guides/wedding-budget-spreadsheet-categories"
      ]
    },
    "weddingtimelinetemplate.com": {
      "root_action": "redirect",
      "root_target": "/wedding-timeline-template",
      "product_id": "timeline-template",
      "own_tool_paths": [
        "/wedding-timeline-template",
        "/products/timeline-template",
        "/guides/wedding-day-timeline-template"
      ]
    },
    "weddingseatingchartmaker.com": {
      "root_action": "redirect",
      "root_target": "/wedding-seating-chart",
      "product_id": "seating-chart-maker",
      "own_tool_paths": [
        "/wedding-seating-chart",
        "/products/seating-chart-maker",
        "/guides/wedding-seating-chart-template"
      ]
    }
  },
  "alias_hosts": {
    "weddingpdfchecklist.com": {
      "redirects_to": "weddingchecklistpdf.com",
      "status": 301,
      "indexable": false,
      "reason": "Five published Kindle EPUBs print https://weddingpdfchecklist.com/amazon/<slug> on their last page. The domain transposes the canonical one and the link is baked into files that are already on sale, so the path cannot be edited from this repo. The host is served only as a permanent redirect that preserves the path: it is never a second indexable copy of the site, and the per-slug path survives the hop so the canonical page records the visit.",
      "book_paths": [
        "/amazon/wedding-day-timeline",
        "/amazon/wedding-vendor-questions",
        "/amazon/wedding-seating-chart",
        "/amazon/wedding-budget-line-by-line",
        "/amazon/wedding-guest-list-problem"
      ]
    }
  },
